# AI ve film sağlayıcıları
OMDB_API_KEY=your-omdb-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Docker Compose PostgreSQL ayarları
POSTGRES_DB=film_archive
POSTGRES_USER=filmApp
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/film_archive

# İsteğe bağlı özellikler
REDIS_QUERY_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6380
SEMANTIC_BACKFILL_ON_STARTUP=false
CATALOG_REFRESH_ON_STARTUP=false
CATALOG_BOOTSTRAP_ENABLED=true
