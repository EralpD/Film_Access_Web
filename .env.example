# External film and AI providers
OMDB_API_KEY=your-omdb-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Docker Compose PostgreSQL and application datasource
POSTGRES_DB=film_archive
POSTGRES_USER=filmApp
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/film_archive

# Semantic search and embedding maintenance
SEMANTIC_BACKFILL_ON_STARTUP=false
SEMANTIC_EMBEDDING_BATCH_SIZE=64
ARCHIVE_SEARCH_SPELLING_CANDIDATES=200
ARCHIVE_SEARCH_REPAIR_ENABLED=true

# Optional Redis query-embedding cache
REDIS_QUERY_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6380

# Catalog maintenance and bootstrap
CATALOG_REFRESH_ON_STARTUP=false
CATALOG_METADATA_REFRESH_ENABLED=true
CATALOG_BOOTSTRAP_ENABLED=true
CATALOG_BOOTSTRAP_DATASET_PATH=film-data/title.basics.tsv.gz
CATALOG_BOOTSTRAP_RATINGS_PATH=https://datasets.imdbws.com/title.ratings.tsv.gz
CATALOG_BOOTSTRAP_MAX_FILMS=50
CATALOG_BOOTSTRAP_REQUEST_DELAY=250ms
CATALOG_BOOTSTRAP_MAX_CONSECUTIVE_FAILURES=20
